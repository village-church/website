---
interface Props {
  title: string;
  subtitle: string;
  image: ImageMetadata;
}

const { title, subtitle, image } = Astro.props;
---

<section class="tile-section">
  <img 
    src={image.src}
    alt={title}
  />

  <div class="content">
    <h2>{title}</h2>
  </div>

  <div class="subtitle-bar">
    <p>{subtitle}</p>
  </div>
</section>

<style>
  .tile-section {
   display: flex;
   justify-content: center;
   align-items: center;
   position: relative;
   width: 100%;
   height: 350px;
  }

  .tile-section img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .content {
      position: absolute;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: white;
      font-weight: bold;
      
      
  }

  .subtitle-bar {
    position:absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: blue;
    color: white;
    text-align: center;
    padding: 1rem;
    box-sizing: border-box;
  }

</style>
